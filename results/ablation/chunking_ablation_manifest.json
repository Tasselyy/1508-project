{
  "paragraph": {
    "config": {
      "corpus": {
        "target_size": 150,
        "local_corpus_cache": "data\\corpus_cache_quick_paragraph.parquet",
        "seed": 42
      },
      "chunking": {
        "strategy": "paragraph",
        "sentence_window_size": 3,
        "sentence_window_stride": 2,
        "adaptive_min_words": 60,
        "adaptive_max_words": 120
      },
      "queries": {
        "sample_size_per_group": 30,
        "seed": 42
      },
      "retrieval": {
        "k_values": [
          1,
          5,
          10,
          20
        ]
      },
      "models": {
        "biencoder": "sentence-transformers/all-MiniLM-L6-v2",
        "colbert": "colbert-ir/colbertv2.0"
      },
      "colbert": {
        "bsize": 8
      },
      "paths": {
        "results_dir": "results\\ablation\\paragraph",
        "faiss_index_dir": "results\\ablation\\paragraph\\faiss_index",
        "colbert_index_dir": "results\\ablation\\paragraph\\colbert_index",
        "json_log": "results\\ablation\\paragraph\\benchmark_log.json",
        "charts_dir": "results\\ablation\\paragraph\\charts",
        "csv_output": "results\\ablation\\paragraph\\summary_statistics.csv"
      },
      "spacy": {
        "model": "en_core_web_sm",
        "entity_threshold": 2
      }
    },
    "log_path": "results\\ablation\\paragraph\\benchmark_log.json",
    "charts": {
      "recall_bar_chart": "results\\ablation\\paragraph\\charts\\recall_bar_chart.png",
      "recall_histograms": [
        "results\\ablation\\paragraph\\charts\\recall_histogram_k1.png",
