        "results\\ablation\\paragraph\\charts\\recall_histogram_k10.png",
        "results\\ablation\\paragraph\\charts\\recall_histogram_k20.png"
      ],
      "latency_comparison": "results\\ablation\\paragraph\\charts\\latency_comparison.png",
      "index_size_comparison": "results\\ablation\\paragraph\\charts\\index_size_comparison.png",
      "summary_csv": "results\\ablation\\paragraph\\summary_statistics.csv"
    }
  },
